PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Allowed CORS origins (comma-separated or *)
CORS_ORIGIN=*

# iProg SMS credentials
IPROG_API_TOKEN=your_iprog_api_token_here

# Semaphore SMS credentials (add your key if you have one)
SEMAPHORE_API_KEY=

# Email settings for OTP
SMTP_USER=
SMTP_PASS=

# Redis (optional for Bull queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
